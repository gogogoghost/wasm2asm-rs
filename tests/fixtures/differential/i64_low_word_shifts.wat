(module
  (memory (export "memory") 1)
  (data (i32.const 65528) "\ef\cd\ab\89\67\45\23\81")
  (global $effects (mut i32) (i32.const 0))
  (func $left (result i64)
    (global.set $effects (i32.add (global.get $effects) (i32.const 1)))
    (i64.const 0x8123456789abcdef))
  (func $right (param $count i64) (result i64)
    (global.set $effects (i32.add (global.get $effects) (i32.const 10)))
    (local.get $count))
  (func (export "dynamic") (param $value i64) (param $count i64) (result i32)
    (i32.wrap_i64 (i64.shl (local.get $value) (local.get $count))))
  (func (export "constant") (param $value i64) (result i32 i32 i32 i32 i32 i32 i32 i32)
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 0)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 1)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 31)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 32)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 33)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 63)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 64)))
    (i32.wrap_i64 (i64.shl (local.get $value) (i64.const 65))))
  (func (export "effectful") (param $count i64) (result i32 i32)
    (global.set $effects (i32.const 0))
    (i32.wrap_i64 (i64.shl (call $left) (call $right (local.get $count))))
    (global.get $effects))
  (func (export "load_shift") (param $address i32) (param $count i64) (result i32)
    (i32.wrap_i64 (i64.shl (i64.load (local.get $address)) (local.get $count)))))
