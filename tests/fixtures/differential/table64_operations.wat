(module
  (type $unary (func (param i32) (result i32)))
  (func $inc (type $unary) (param i32) (result i32)
    local.get 0 i32.const 1 i32.add)
  (func $double (type $unary) (param i32) (result i32)
    local.get 0 i32.const 2 i32.mul)
  (table $functions i64 2 4 funcref)
  (elem (table $functions) (i64.const 0) func $inc $double)
  (func (export "apply") (param i64 i32) (result i32)
    local.get 1 local.get 0 call_indirect $functions (type $unary))
  (func (export "set") (param i64)
    local.get 0 ref.func $inc table.set $functions)
  (func (export "fill") (param i64 i64)
    local.get 0 ref.null func local.get 1 table.fill $functions)
  (func (export "copy") (param i64 i64 i64)
    local.get 0 local.get 1 local.get 2 table.copy $functions $functions)
  (func (export "size") (result i64)
    table.size $functions)
  (func (export "grow") (param i64) (result i64)
    ref.null func local.get 0 table.grow $functions))
