(module
      (func (export "f32ops")
        (result f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32)
        (f32.abs (f32.const -3.5))
        (f32.neg (f32.const 2.5))
        (f32.ceil (f32.const 1.25))
        (f32.floor (f32.const 1.75))
        (f32.trunc (f32.const -1.75))
        (f32.nearest (f32.const 2.5))
        (f32.sqrt (f32.const 9))
        (f32.add (f32.const 1.5) (f32.const 2.25))
        (f32.sub (f32.const 1.5) (f32.const 2.25))
        (f32.mul (f32.const 1.5) (f32.const 2.25))
        (f32.div (f32.const 7) (f32.const 2))
        (f32.min (f32.const -0.0) (f32.const 0.0))
        (f32.max (f32.const -0.0) (f32.const 0.0))
        (f32.copysign (f32.const 3.5) (f32.const -1)))
      (func (export "f64ops")
        (result f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64)
        (f64.abs (f64.const -3.5))
        (f64.neg (f64.const 2.5))
        (f64.ceil (f64.const 1.25))
        (f64.floor (f64.const 1.75))
        (f64.trunc (f64.const -1.75))
        (f64.nearest (f64.const 2.5))
        (f64.sqrt (f64.const 9))
        (f64.add (f64.const 1.5) (f64.const 2.25))
        (f64.sub (f64.const 1.5) (f64.const 2.25))
        (f64.mul (f64.const 1.5) (f64.const 2.25))
        (f64.div (f64.const 7) (f64.const 2))
        (f64.min (f64.const -0.0) (f64.const 0.0))
        (f64.max (f64.const -0.0) (f64.const 0.0))
        (f64.copysign (f64.const 3.5) (f64.const -1)))
      (func (export "cmp")
        (result i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
        (f32.eq (f32.const 1) (f32.const 1))
        (f32.ne (f32.const 1) (f32.const 2))
        (f32.lt (f32.const 1) (f32.const 2))
        (f32.gt (f32.const 2) (f32.const 1))
        (f32.le (f32.const 2) (f32.const 2))
        (f32.ge (f32.const 3) (f32.const 2))
        (f64.eq (f64.const 1) (f64.const 1))
        (f64.ne (f64.const 1) (f64.const 2))
        (f64.lt (f64.const 1) (f64.const 2))
        (f64.gt (f64.const 2) (f64.const 1))
        (f64.le (f64.const 2) (f64.const 2))
        (f64.ge (f64.const 3) (f64.const 2))))
