(module
  (func (export "ops") (param $value i64) (param $count i64)
    (result i64 i64 i64 i64 i64)
    (i64.rotl (local.get $value) (local.get $count))
    (i64.rotr (local.get $value) (local.get $count))
    (i64.shl (local.get $value) (local.get $count))
    (i64.shr_s (local.get $value) (local.get $count))
    (i64.shr_u (local.get $value) (local.get $count)))
  (func (export "constant_counts") (param $value i64)
    (result i64 i64 i64 i64)
    (i64.rotl (local.get $value) (i64.const 32))
    (i64.rotr (local.get $value) (i64.const 32))
    (i64.rotl (local.get $value) (i64.const 96))
    (i64.rotr (local.get $value) (i64.const -32))))
