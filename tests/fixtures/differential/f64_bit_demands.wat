(module
  (import "env" "echo" (func $echo (param f64) (result f64)))
  (import "env" "count" (func $count (result i32)))
  (memory (export "memory") 1 1)
  (func $loaded (param $p i32) (result f64)
    (f64.load (local.get $p)))
  (func (export "numeric") (param $p i32) (result f64)
    (f64.add (f64.load (local.get $p))
             (f64.mul (f64.load offset=8 (local.get $p)) (f64.const 2))))
  (func (export "numeric_local") (param $p i32) (result f64)
    (local $x f64)
    (local.set $x (f64.load (local.get $p)))
    (f64.mul (local.get $x) (f64.const 2)))
  (func (export "numeric_call") (param $p i32) (result f64)
    (f64.mul (call $loaded (local.get $p)) (f64.const 2)))
  (func (export "import_load") (param $p i32) (result f64)
    (f64.mul (call $echo (f64.load (local.get $p))) (f64.const 2)))
  (func (export "mixed") (param $p i32) (result i64)
    (local $x f64)
    (drop (f64.add (local.tee $x (f64.load (local.get $p))) (f64.const 1)))
    (f64.store (i32.const 64) (local.get $x))
    (i64.reinterpret_f64 (local.get $x)))
  ;; An old operand-stack read must survive the overwrite of its local.
  (func (export "overwrite") (param $p i32) (result i64)
    (local $x f64)
    (local.set $x (f64.load (local.get $p)))
    (local.get $x)
    (local.set $x (f64.load offset=8 (local.get $p)))
    (f64.store (i32.const 72) (local.get $x))
    (i64.reinterpret_f64))
  ;; Both loads execute before select consumes either raw value.
  (func (export "two_loads") (param $p i32) (param $take i32) (result i64)
    (i64.reinterpret_f64
      (select (f64.load (local.get $p))
              (f64.load offset=8 (local.get $p)) (local.get $take))))
  ;; Capturing bits must not be deferred until after the address is mutated.
  (func (export "mutate") (param $p i32) (result i64)
    (local $x f64)
    (local.set $x (f64.load (local.get $p)))
    (i64.store (local.get $p) (i64.const 0))
    (i64.reinterpret_f64 (local.get $x)))
  (func (export "branch") (param $p i32) (param $take i32) (result i64)
    (i64.reinterpret_f64
      (if (result f64) (local.get $take)
        (then (f64.load (local.get $p)))
        (else (f64.load offset=8 (local.get $p))))))
  (func (export "loop") (param $p i32) (param $n i32) (result i64)
    (local $x f64) (local $bits i64)
    (local.set $x (f64.load (local.get $p)))
    (loop $again
      (local.set $bits (i64.reinterpret_f64 (local.get $x)))
      (local.set $x (f64.load offset=8 (local.get $p)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br_if $again (local.get $n)))
    (local.get $bits))
  (func (export "abs_bits") (param $p i32) (result i64)
    (i64.reinterpret_f64 (f64.abs (f64.load (local.get $p)))))
  (func (export "neg_bits") (param $p i32) (result i64)
    (i64.reinterpret_f64 (f64.neg (f64.load (local.get $p)))))
  (func (export "copy_bits") (param $p i32) (result i64)
    (i64.reinterpret_f64
      (f64.copysign (f64.load (local.get $p)) (f64.load offset=8 (local.get $p)))))
  (func (export "sign_stores") (param $p i32)
    (local $x f64)
    (local.set $x (f64.load (local.get $p)))
    (f64.store (i32.const 64) (f64.abs (local.get $x)))
    (f64.store (i32.const 72) (f64.neg (local.get $x)))
    (f64.store (i32.const 80)
      (f64.copysign (local.get $x) (f64.load offset=8 (local.get $p)))))
  ;; The sign operand has no raw-bit consumer other than copysign itself.
  ;; In particular, a negative NaN must produce -1 rather than +1 here.
  (func (export "numeric_sign") (param $p i32) (result i32)
    (i32.trunc_f64_s (f64.copysign (f64.const 1) (f64.load (local.get $p)))))
  (func (export "numeric_neg_sign") (param $p i32) (result i32)
    (i32.trunc_f64_s
      (f64.copysign (f64.const 1) (f64.neg (f64.load (local.get $p))))))
  (func (export "numeric_abs_sign") (param $p i32) (result i32)
    (i32.trunc_f64_s
      (f64.copysign (f64.const 1) (f64.abs (f64.load (local.get $p))))))
  (func (export "param_abs_bits") (param $x f64) (result i64)
    (i64.reinterpret_f64 (f64.abs (local.get $x))))
  (func (export "param_neg_bits") (param $x f64) (result i64)
    (i64.reinterpret_f64 (f64.neg (local.get $x))))
  ;; Seed parameter locals inside Wasm: JS/asm entry and foreign helper
  ;; boundaries can canonicalize NaNs before their raw sign is observable.
  (func (export "loaded_param_abs_bits") (param $x f64) (param $p i32) (result i64)
    (local.set $x (f64.load (local.get $p)))
    (i64.reinterpret_f64 (f64.abs (local.get $x))))
  (func (export "loaded_param_neg_bits") (param $x f64) (param $p i32) (result i64)
    (local.set $x (f64.load (local.get $p)))
    (i64.reinterpret_f64 (f64.neg (local.get $x))))
  (func (export "import_numeric") (param $x f64) (result f64)
    (f64.mul (call $echo (local.get $x)) (f64.const 2)))
  (func (export "import_bits") (param $x f64) (result i64)
    (i64.reinterpret_f64 (call $echo (local.get $x))))
  (func (export "discard_import") (param $x f64) (result i32)
    (drop (call $echo (local.get $x)))
    (call $count))
  (func (export "seed") (param $p i32) (param $low i32) (param $high i32)
    (i64.store align=1 (local.get $p)
      (i64.or (i64.extend_i32_u (local.get $low))
        (i64.shl (i64.extend_i32_u (local.get $high)) (i64.const 32)))))
  (func (export "stored0") (result i64) (i64.load (i32.const 64)))
  (func (export "stored1") (result i64) (i64.load (i32.const 72)))
  (func (export "stored2") (result i64) (i64.load (i32.const 80)))
  (func (export "bytes") (result i32)
    (i32.shl (memory.size) (i32.const 16)))
  (func (export "discard_load") (param $p i32)
    (drop (f64.load (local.get $p)))))
